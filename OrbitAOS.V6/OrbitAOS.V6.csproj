<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Upgraded from net6.0 to net10.0 as part of ASP.NET MVC 6.0 to .NET 10 Core MVC migration -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>aspnet-OrbitAOS.V6-afe03967-a771-44f8-b4ff-ee887e025b4f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- All packages upgraded from 6.0.19 to 10.0.0 for .NET 10 compatibility -->
    <!-- Breaking change: EF Core 6.x -> EF Core 10.x (migration files must be regenerated) -->
    <!-- Breaking change: Identity packages 6.x -> 10.x (schema compatible, API changes apply) -->
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
