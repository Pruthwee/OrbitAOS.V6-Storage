@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to OrbitAOS</h1>
    <p>
        This application has been migrated from ASP.NET MVC 6.0 to
        <strong>ASP.NET Core MVC on .NET 8</strong> using Clean Architecture.
    </p>
    <p>
        Learn about <a href="https://docs.microsoft.com/aspnet/core" target="_blank" rel="noopener">
            building Web apps with ASP.NET Core
        </a>.
    </p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Clean Architecture</h5>
                <p class="card-text">
                    Organized into Domain, Application, Infrastructure, and Web layers
                    for maintainability and testability.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">.NET 8 LTS</h5>
                <p class="card-text">
                    Running on .NET 8 Long-Term Support with the latest performance
                    improvements and security features.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">EF Core 8</h5>
                <p class="card-text">
                    Data access powered by Entity Framework Core 8, replacing
                    the legacy Entity Framework 6 / EF6 stack.
                </p>
            </div>
        </div>
    </div>
</div>
