@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to OrbitAOS</h1>
    <p class="lead">
        This application has been migrated from ASP.NET MVC 6.0 (.NET Framework) to
        <strong>ASP.NET Core MVC on .NET 8</strong> using Clean Architecture.
    </p>
    <p>
        Learn about <a href="https://docs.microsoft.com/aspnet/core" target="_blank" rel="noopener">
            building Web apps with ASP.NET Core
        </a>.
    </p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Clean Architecture</h5>
                <p class="card-text">
                    Migrated to a layered architecture: Domain, Application, Infrastructure, and Web.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">.NET 8 LTS</h5>
                <p class="card-text">
                    Running on .NET 8 Long-Term Support with EF Core 8.0 and ASP.NET Core Identity.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Modern Security</h5>
                <p class="card-text">
                    Cookie Authentication with ASP.NET Core Identity replaces legacy Forms Authentication.
                </p>
            </div>
        </div>
    </div>
</div>
