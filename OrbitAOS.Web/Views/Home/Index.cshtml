@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to OrbitAOS</h1>
    <p>
        OrbitAOS is now running on <strong>.NET 10</strong> with Clean Architecture.
        Learn about <a href="https://learn.microsoft.com/aspnet/core" target="_blank" rel="noopener">building Web apps with ASP.NET Core</a>.
    </p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Clean Architecture</h5>
                <p class="card-text">
                    This application follows Clean Architecture principles with Domain, Application,
                    Infrastructure, and Web layers.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">.NET 10</h5>
                <p class="card-text">
                    Migrated from ASP.NET MVC 6.0 (net6.0) to ASP.NET Core MVC on .NET 10
                    with the latest performance improvements.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">EF Core 10</h5>
                <p class="card-text">
                    Data access powered by Entity Framework Core 10 with SQL Server,
                    supporting code-first migrations.
                </p>
            </div>
        </div>
    </div>
</div>
