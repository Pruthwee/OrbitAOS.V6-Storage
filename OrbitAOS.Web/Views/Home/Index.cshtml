@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to OrbitAOS</h1>
    <p>
        A modern ASP.NET Core MVC application on .NET 10 with Clean Architecture.
    </p>
    <p>
        Learn about <a href="https://docs.microsoft.com/aspnet/core" target="_blank" rel="noopener">building Web apps with ASP.NET Core</a>.
    </p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Clean Architecture</h5>
                <p class="card-text">Built with Domain, Application, Infrastructure, and Web layers for maintainability.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">.NET 10</h5>
                <p class="card-text">Migrated from ASP.NET MVC 6.0 to ASP.NET Core MVC on .NET 10.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">EF Core 10</h5>
                <p class="card-text">Data access powered by Entity Framework Core 10 with SQL Server.</p>
            </div>
        </div>
    </div>
</div>
